<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Actual_End_Date_Needed_When_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Completed&quot;), ISBLANK(Actual_End_Date__c))</errorConditionFormula>
    <errorDisplayField>Actual_End_Date__c</errorDisplayField>
    <errorMessage>Enter the Actual End Date when the project is marked Completed.</errorMessage>
</ValidationRule>
